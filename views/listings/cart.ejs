<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>My Cart</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- Existing CSS -->
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/marquee.css">
    <link rel="stylesheet" href="/css/nav.css">

    <!-- Cart CSS -->
    <link rel="stylesheet" href="/css/card.css">

    <!-- Favicon -->
    <link rel="icon"
        type="image/x-icon"
        href="/images/rest.png">

</head>


<body>


    <!-- Existing marquee -->
    <%- include("../partials/marquee") %>


    <!-- Existing navbar -->
    <%- include("../partials/nav") %>



    <%
        let total = 0;

        cart.forEach(item => {
            total += Number(item.price);
        });
    %>



    <!-- =====================================================
                            MAIN
    ===================================================== -->

    <main class="cart-page">


        <!-- ================= TITLE ================= -->

        <h1 class="cart-title">
            My Cart
        </h1>



        <!-- ================= YOUR ITEMS ================= -->

        <h2 class="your-items-title">
            Your Items
        </h2>



        <!-- ================= CART ITEMS ================= -->

        <% if(cart.length === 0) { %>


            <div class="empty-cart">

                <i class="fa-solid fa-cart-shopping"></i>

                <p>
                    Your cart is empty
                </p>

            </div>


        <% } else { %>


            <div class="cart-items-container">


                <% cart.forEach((item, index) => { %>


                    <!-- =================================================
                                    SINGLE ITEM
                    ================================================= -->

                    <div class="cart-item"
                        data-index="<%= index %>"
                        data-price="<%= item.price %>">


                        <!-- IMAGE -->

                        <div class="cart-item-image">

                            <img
                                src="<%= item.image.url %>"
                                alt="<%= item.title %>"
                            >

                        </div>



                        <!-- DETAILS -->

                        <div class="cart-item-details">


                            <!-- TITLE -->

                            <h3 class="cart-item-title">

                                <%= item.title %>

                            </h3>



                            <!-- VARIATION -->

                            <p class="cart-variation">

                                Variation:
                                <%= item.variation %>

                            </p>



                            <!-- PRICE -->

                            <p class="cart-item-price">

                                ₹<span class="single-price">

                                    <%= Number(item.price).toLocaleString("en-IN", {
                                        minimumFractionDigits: 2
                                    }) %>

                                </span>

                            </p>


                        </div>



                        <!-- =================================================
                                    QUANTITY
                        ================================================= -->

                        <div class="quantity-wrapper">


                            <button
                                type="button"
                                class="quantity-minus"
                                onclick="changeQty(this, -1)"
                            >

                                −

                            </button>


                            <span class="quantity">

                                1

                            </span>


                            <button
                                type="button"
                                class="quantity-plus"
                                onclick="changeQty(this, 1)"
                            >

                                +

                            </button>


                        </div>


                    </div>


                <% }) %>


            </div>


        <% } %>



        <!-- =====================================================
                            CART SUMMARY
        ===================================================== -->


        <% if(cart.length > 0) { %>


            <div class="cart-summary">


                <h2>
                    Cart Summary
                </h2>


                <div class="summary-line">

                    <span>
                        Subtotal
                    </span>

                    <span id="summarySubtotal">

                        ₹<%= total.toLocaleString("en-IN", {
                            minimumFractionDigits: 2
                        }) %>

                    </span>

                </div>



                <div class="summary-line">

                    <span>
                        Delivery
                    </span>

                    <span>
                        ₹0.00
                    </span>

                </div>



                <div class="summary-divider"></div>



                <div class="summary-total">

                    <span>
                        Total Amount
                    </span>

                    <span id="summaryTotal">

                        ₹<%= total.toLocaleString("en-IN", {
                            minimumFractionDigits: 2
                        }) %>

                    </span>

                </div>


            </div>


        <% } %>


    </main>



    <!-- =====================================================
                        FIXED CHECKOUT BAR
    ===================================================== -->


    <% if(cart.length > 0) { %>


        <div class="checkout-bar">


            <!-- TOTAL -->

            <div class="bottom-total">

                <span>
                    Total
                </span>

                <strong id="bottomTotal">

                    ₹<%= total.toLocaleString("en-IN", {
                        minimumFractionDigits: 2
                    }) %>

                </strong>

            </div>



            <!-- CHECKOUT -->

            <button
                type="button"
                class="proceed-button"
                onclick="proceedToCheckout()"
            >

                Proceed to Checkout

            </button>


        </div>


    <% } %>



    


        <!-- CART -->

       




    <!-- =====================================================
                            JAVASCRIPT
    ===================================================== -->

    <script>


        // =====================================================
        // CHANGE QUANTITY
        // =====================================================

        function changeQty(button, change) {


            const cartItem =
                button.closest(".cart-item");


            const quantityElement =
                cartItem.querySelector(".quantity");


            const price =
                Number(cartItem.dataset.price);


            let quantity =
                Number(quantityElement.innerText);



            // ================================================
            // MINUS
            // ================================================

            if(change === -1) {


                // If quantity is already 1
                // remove item from cart

                if(quantity === 1) {

                    removeCartItem(cartItem);

                    return;

                }


                quantity--;

            }



            // ================================================
            // PLUS
            // ================================================

            if(change === 1) {

                quantity++;

            }



            quantityElement.innerText =
                quantity;



            updateCartTotal();

        }




        // =====================================================
        // REMOVE ITEM
        // =====================================================

        function removeCartItem(cartItem) {


            const index =
                cartItem.dataset.index;


            /*
             * Existing backend route
             *
             * /cart/remove/:index
             */

            const form =
                document.createElement("form");


            form.method = "POST";

            form.action =
                "/cart/remove/" + index;


            document.body.appendChild(form);


            form.submit();

        }




        // =====================================================
        // UPDATE TOTAL
        // =====================================================

        function updateCartTotal() {


            let subtotal = 0;



            document
                .querySelectorAll(".cart-item")
                .forEach(item => {


                    const price =
                        Number(item.dataset.price);


                    const quantity =
                        Number(
                            item.querySelector(".quantity").innerText
                        );


                    subtotal +=
                        price * quantity;


                });



            const formatted =
                subtotal.toLocaleString("en-IN", {
                    minimumFractionDigits: 2
                });



            // Summary subtotal

            const summarySubtotal =
                document.getElementById(
                    "summarySubtotal"
                );


            if(summarySubtotal) {

                summarySubtotal.innerText =
                    "₹" + formatted;

            }



            // Summary total

            const summaryTotal =
                document.getElementById(
                    "summaryTotal"
                );


            if(summaryTotal) {

                summaryTotal.innerText =
                    "₹" + formatted;

            }



            // Bottom total

            const bottomTotal =
                document.getElementById(
                    "bottomTotal"
                );


            if(bottomTotal) {

                bottomTotal.innerText =
                    "₹" + formatted;

            }

        }




        // =====================================================
        // PROCEED TO CHECKOUT
        // =====================================================

        function proceedToCheckout() {


            const order = [];


            document
                .querySelectorAll(".cart-item")
                .forEach(item => {


                    const title =
                        item
                            .querySelector(".cart-item-title")
                            .innerText
                            .trim();


                    const variation =
                        item
                            .querySelector(".cart-variation")
                            .innerText
                            .replace("Variation:", "")
                            .trim();


                    const price =
                        Number(item.dataset.price);


                    const quantity =
                        Number(
                            item
                                .querySelector(".quantity")
                                .innerText
                        );


                    order.push({

                        title: title,

                        variation: variation,

                        price: price,

                        quantity: quantity

                    });


                });



            localStorage.setItem(
                "order",
                JSON.stringify(order)
            );



            window.location.href =
                "/address";


        }


    </script>


</body>

</html>