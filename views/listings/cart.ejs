
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>My Cart</title>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/marquee.css">
    <link rel="stylesheet" href="/css/nav.css">
    <link rel="stylesheet" href="/css/card.css">

    <link rel="icon"
        type="image/x-icon"
        href="/images/rest.png">

</head>


<body>

    <!-- Marquee -->
    <%- include("../partials/marquee") %>


    <!-- Navbar -->
    <%- include("../partials/nav") %>


    <%
        let total = 0;

        cart.forEach(item => {
            total += Number(item.price);
        });

        const deliveryCharge = 30;
        const grandTotal = total + deliveryCharge;
    %>


    <!-- ================= MAIN ================= -->

    <main class="cart-page">

        <h1 class="cart-title">
            My Cart
        </h1>


        <h2 class="your-items-title">
            Your Items
        </h2>


        <!-- ================= CART ================= -->

        <% if(cart.length === 0) { %>

            <div class="empty-cart">

                <i class="fa-solid fa-cart-shopping"></i>

                <p>
                    Your cart is empty
                </p>

            </div>

        <% } else { %>


            <div class="cart-items-container">


                <% cart.forEach((item, index) => { %>


                    <!-- SINGLE CARD -->

                    <div class="cart-item"
                        data-index="<%= index %>"
                        data-price="<%= item.price %>">


                        <!-- IMAGE -->

                        <div class="cart-item-image">

                            <img
                                src="<%= item.image.url %>"
                                alt="<%= item.title %>"
                            >

                        </div>


                        <!-- DETAILS -->

                        <div class="cart-item-details">

                            <h3 class="cart-item-title">
                                <%= item.title %>
                            </h3>


                            <p class="cart-variation">

                                Variation:
                                <%= item.variation %>

                            </p>


                            <p class="cart-item-price">

                                ₹<span class="single-price">
                                    <%= Number(item.price).toLocaleString("en-IN") %>
                                </span>

                            </p>

                        </div>


                        <!-- QUANTITY -->

                        <div class="quantity-wrapper">

                            <button
                                type="button"
                                class="quantity-minus"
                                onclick="changeQty(this, -1)"
                            >
                                −
                            </button>


                            <span class="quantity">
                                1
                            </span>


                            <button
                                type="button"
                                class="quantity-plus"
                                onclick="changeQty(this, 1)"
                            >
                                +
                            </button>

                        </div>


                    </div>


                <% }) %>


            </div>


        <% } %>



        <!-- ================= CART SUMMARY ================= -->

        <% if(cart.length > 0) { %>


            <div class="cart-summary">

                <h2>
                    Cart Summary
                </h2>


                <!-- SUBTOTAL -->

                <div class="summary-line">

                    <span>
                        Subtotal
                    </span>

                    <span id="summarySubtotal">

                        ₹<%= total.toLocaleString("en-IN", {
                            minimumFractionDigits: 2
                        }) %>

                    </span>

                </div>


                <!-- DELIVERY -->

                <div class="summary-line">

                    <span>
                        Delivery
                    </span>

                    <span id="deliveryCharge">
                        ₹30.00
                    </span>

                </div>


                <div class="summary-divider"></div>


                <!-- TOTAL -->

                <div class="summary-total">

                    <span>
                        Total Amount
                    </span>

                    <span id="summaryTotal">

                        ₹<%= grandTotal.toLocaleString("en-IN", {
                            minimumFractionDigits: 2
                        }) %>

                    </span>

                </div>


            </div>


        <% } %>


    </main>



    <!-- ================= FIXED CHECKOUT BAR ================= -->

    <% if(cart.length > 0) { %>


        <div class="checkout-bar">


            <div class="bottom-total">

                <span>
                    Total
                </span>

                <strong id="bottomTotal">

                    ₹<%= grandTotal.toLocaleString("en-IN", {
                        minimumFractionDigits: 2
                    }) %>

                </strong>

            </div>


            <button
                type="button"
                class="proceed-button"
                onclick="proceedToCheckout()"
            >

                Proceed to Checkout

            </button>


        </div>


    <% } %>



    <!-- ================= JAVASCRIPT ================= -->

    <script>


        // ==========================================
        // CHANGE QUANTITY
        // ==========================================

        function changeQty(button, change) {

            const cartItem =
                button.closest(".cart-item");


            const quantityElement =
                cartItem.querySelector(".quantity");


            const priceElement =
                cartItem.querySelector(".single-price");


            const unitPrice =
                Number(cartItem.dataset.price);


            let quantity =
                Number(quantityElement.innerText);


            // ==========================
            // MINUS
            // ==========================

            if (change === -1) {

                // Quantity 1 par minus
                // karne par item remove

                if (quantity === 1) {

                    removeCartItem(cartItem);

                    return;
                }

                quantity--;

            }


            // ==========================
            // PLUS
            // ==========================

            if (change === 1) {

                quantity++;

            }


            // Quantity update

            quantityElement.innerText =
                quantity;


            // ==========================
            // ITEM PRICE UPDATE
            // ==========================

            const itemTotal =
                unitPrice * quantity;


            priceElement.innerText =
                itemTotal.toLocaleString("en-IN");


            // ==========================
            // GRAND TOTAL
            // ==========================

            updateCartTotal();

        }



        // ==========================================
        // REMOVE ITEM
        // ==========================================

        function removeCartItem(cartItem) {

            const index =
                cartItem.dataset.index;


            const form =
                document.createElement("form");


            form.method = "POST";


            form.action =
                "/cart/remove/" + index;


            document.body.appendChild(form);


            form.submit();

        }



        // ==========================================
        // UPDATE TOTAL
        // ==========================================

        function updateCartTotal() {

            let subtotal = 0;


            document
                .querySelectorAll(".cart-item")
                .forEach(item => {


                    const price =
                        Number(item.dataset.price);


                    const quantity =
                        Number(
                            item.querySelector(".quantity").innerText
                        );


                    subtotal +=
                        price * quantity;

                });


            // ==========================
            // DELIVERY CHARGE
            // ==========================

            const deliveryCharge = 30;


            // ==========================
            // GRAND TOTAL
            // ==========================

            const grandTotal =
                subtotal + deliveryCharge;


            const formattedSubtotal =
                subtotal.toLocaleString("en-IN", {

                    minimumFractionDigits: 2

                });


            const formattedTotal =
                grandTotal.toLocaleString("en-IN", {

                    minimumFractionDigits: 2

                });


            // ==========================
            // SUMMARY SUBTOTAL
            // ==========================

            const summarySubtotal =
                document.getElementById(
                    "summarySubtotal"
                );


            if(summarySubtotal) {

                summarySubtotal.innerText =
                    "₹" + formattedSubtotal;

            }


            // ==========================
            // SUMMARY TOTAL
            // ==========================

            const summaryTotal =
                document.getElementById(
                    "summaryTotal"
                );


            if(summaryTotal) {

                summaryTotal.innerText =
                    "₹" + formattedTotal;

            }


            // ==========================
            // BOTTOM TOTAL
            // ==========================

            const bottomTotal =
                document.getElementById(
                    "bottomTotal"
                );


            if(bottomTotal) {

                bottomTotal.innerText =
                    "₹" + formattedTotal;

            }

        }



        // ==========================================
        // PROCEED TO CHECKOUT
        // ==========================================

        function proceedToCheckout() {

            const order = [];

            let subtotal = 0;


            document
                .querySelectorAll(".cart-item")
                .forEach(item => {


                    const title =
                        item
                            .querySelector(".cart-item-title")
                            .innerText
                            .trim();


                    const variation =
                        item
                            .querySelector(".cart-variation")
                            .innerText
                            .replace("Variation:", "")
                            .trim();


                    const price =
                        Number(item.dataset.price);


                    const quantity =
                        Number(
                            item
                                .querySelector(".quantity")
                                .innerText
                        );


                    subtotal +=
                        price * quantity;


                    order.push({

                        title: title,

                        variation: variation,

                        price: price,

                        quantity: quantity

                    });

                });


            // ==========================
            // DELIVERY + TOTAL
            // ==========================

            const deliveryCharge = 30;

            const grandTotal =
                subtotal + deliveryCharge;


            // Save order

            localStorage.setItem(
                "order",
                JSON.stringify(order)
            );


            // Save payment amount

            localStorage.setItem(
                "orderSubtotal",
                subtotal.toString()
            );


            localStorage.setItem(
                "deliveryCharge",
                deliveryCharge.toString()
            );


            localStorage.setItem(
                "orderTotal",
                grandTotal.toString()
            );


            window.location.href =
                "/address";

        }

    </script>


</body>

</html>

