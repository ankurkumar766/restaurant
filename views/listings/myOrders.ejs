<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Orders</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- My Orders CSS -->
    <link rel="stylesheet" href="/css/order.css">

    <!-- Other CSS -->
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/marquee.css">

    <link rel="icon" type="image/x-icon" href="/images/rest.png">
</head>


<body class="bg-light">

    <!-- Marquee -->
    <%- include("../partials/marquee") %>


    <div class="container orders-container">

        <h2 class="orders-title">
            📦 My Orders
        </h2>


        <% if (orders && orders.length > 0) { %>

            <% orders.forEach(order => { %>

                <!-- ================= ORDER CARD ================= -->

                <div class="card order-card shadow-sm">

                    <div class="card-body">


                        <!-- ===== BASIC INFO : ALWAYS VISIBLE ===== -->

                        <div class="basic-info">

                            <p class="order-id-line">
                                <strong>Order ID:</strong>
                                <span class="order-id">
                                    <%= order._id %>
                                </span>
                            </p>

                            <p>
                                <strong>Name:</strong>
                                <%= order.name %>
                            </p>

                            <p>
                                <strong>Phone:</strong>
                                <%= order.phone %>
                            </p>

                        </div>


                        <!-- ===== BUTTONS ===== -->

                        <div class="order-actions">

                            <button
                                type="button"
                                class="btn invoice-btn"
                                onclick="toggleInvoice(this)"
                            >
                                <i class="fa-solid fa-file-invoice"></i>
                                Invoice
                            </button>


                            <button
                                type="button"
                                class="btn track-btn"
                                onclick="toggleTrack(this)"
                            >
                                <i class="fa-solid fa-location-dot"></i>
                                Track
                            </button>

                        </div>


                        <!-- ========================================
                             INVOICE DETAILS
                             PAGE LOAD PAR HIDDEN
                        ========================================= -->

                        <div class="invoice-details">

                            <hr>

                            <p>
                                <strong>
                                    <i class="fa-solid fa-location-dot"></i>
                                    Address:
                                </strong>

                                <%= order.address %>
                            </p>


                            <p>
                                <strong>
                                    <i class="fa-solid fa-credit-card"></i>
                                    Payment:
                                </strong>

                                <%= order.paymentMethod %>
                            </p>


                            <p>
                                <strong>💰 Total Price:</strong>

                                ₹<%= order.totalPrice %>
                            </p>


                            <h6 class="section-title">
                                🍽 Ordered Items
                            </h6>


                            <ul class="list-group">

                                <% order.items.forEach(item => { %>

                                    <li class="list-group-item order-item">

                                        <strong class="food-name">
                                            <%= item.foodName %>
                                        </strong>

                                        <div class="item-details">

                                            <p>
                                                🍽 Size:

                                                <span class="badge bg-info text-dark">
                                                    <%= item.variation %>
                                                </span>
                                            </p>


                                            <p>
                                                🔢 Quantity:
                                                <strong><%= item.quantity %></strong>
                                            </p>


                                            <p>
                                                💰 Price:
                                                <strong>₹<%= item.price %></strong>
                                            </p>

                                        </div>

                                    </li>

                                <% }) %>

                            </ul>


                            <small class="order-date">

                                <i class="fa-solid fa-calendar-days"></i>

                                Ordered on:
                                <%= order.createdAt.toLocaleString() %>

                            </small>

                        </div>
                        <!-- END INVOICE DETAILS -->


                        <!-- ========================================
                             TRACK DETAILS
                             PAGE LOAD PAR HIDDEN
                        ========================================= -->

                        <div class="track-details">

                            <hr>

                            <h6 class="section-title">
                                📦 Order Tracking
                            </h6>


                            <p>

                                <strong>Status:</strong>

                                <% if (order.status === "Pending") { %>

                                    <span class="badge bg-warning text-dark">
                                        🟡 Pending
                                    </span>

                                <% } else if (order.status === "Out for Delivery") { %>

                                    <span class="badge bg-primary">
                                        🚚 Out for Delivery
                                    </span>

                                <% } else { %>

                                    <span class="badge bg-success">
                                        ✅ Delivered
                                    </span>

                                <% } %>

                            </p>


                            <!-- OTP -->

                            <% if (order.status !== "Delivered") { %>

                                <div class="delivery-otp">

                                    <strong>
                                        🔐 Delivery OTP
                                    </strong>

                                    <h4>
                                        <%= order.deliveryOTP %>
                                    </h4>

                                    <small>
                                        Show this OTP to the delivery boy.
                                    </small>

                                </div>

                            <% } %>

                        </div>
                        <!-- END TRACK DETAILS -->


                    </div>

                </div>
                <!-- END ORDER CARD -->


            <% }) %>


        <% } else { %>

            <div class="alert alert-info">
                <i class="fa-solid fa-box-open"></i>
                No orders placed yet.
            </div>

        <% } %>

    </div>


    <!-- Footer -->

    <%- include("../partials/footer") %>


    <!-- ================= JAVASCRIPT ================= -->

    <script>

        function toggleInvoice(button) {

            const card = button.closest(".order-card");

            const invoice = card.querySelector(".invoice-details");
            const track = card.querySelector(".track-details");

            const invoiceButton = card.querySelector(".invoice-btn");
            const trackButton = card.querySelector(".track-btn");


            // Check invoice currently open or closed
            const isInvoiceOpen =
                window.getComputedStyle(invoice).display !== "none";


            // Always close track
            track.style.display = "none";


            // Reset track button
            trackButton.innerHTML = `
                <i class="fa-solid fa-location-dot"></i>
                Track
            `;


            // Toggle invoice
            if (isInvoiceOpen) {

                invoice.style.display = "none";

                invoiceButton.innerHTML = `
                    <i class="fa-solid fa-file-invoice"></i>
                    Invoice
                `;

            } else {

                invoice.style.display = "block";

                invoiceButton.innerHTML = `
                    <i class="fa-solid fa-xmark"></i>
                    Close Invoice
                `;

            }

        }


        function toggleTrack(button) {

            const card = button.closest(".order-card");

            const invoice = card.querySelector(".invoice-details");
            const track = card.querySelector(".track-details");

            const invoiceButton = card.querySelector(".invoice-btn");
            const trackButton = card.querySelector(".track-btn");


            // Check track currently open or closed
            const isTrackOpen =
                window.getComputedStyle(track).display !== "none";


            // Always close invoice
            invoice.style.display = "none";


            // Reset invoice button
            invoiceButton.innerHTML = `
                <i class="fa-solid fa-file-invoice"></i>
                Invoice
            `;


            // Toggle track
            if (isTrackOpen) {

                track.style.display = "none";

                trackButton.innerHTML = `
                    <i class="fa-solid fa-location-dot"></i>
                    Track
                `;

            } else {

                track.style.display = "block";

                trackButton.innerHTML = `
                    <i class="fa-solid fa-xmark"></i>
                    Close Track
                `;

            }

        }

    </script>

</body>

</html>