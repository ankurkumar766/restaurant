<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Payment page</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/marquee.css">
    <link rel="stylesheet" href="/css/address.css">
    <link rel="stylesheet" href="/css/nav.css">
     <link rel="icon" type="image/x-icon" href="/images/rest.png">  
</head>

<body>

    <%- include("../partials/marquee") %>

        <!-- ================= PAYMENT ================= -->
        <%- include("../partials/nav") %>

            <div class="payment-section">

                <h2>Choose Payment Method</h2>

                <div class="payment-card">

                    <div class="qr-box">

                        <img src="/css/images/qr.jpg" class="qr">

                    </div>

                    <div class="upi-details">

                        <h3>Scan & Pay</h3>

                        <p><b>UPI ID</b></p>

                        <div class="upi-id">

                            7667880272-2@ybl

                        </div>

                        <div class="payment-buttons">

                            <button type="button" class="pay-btn phonepe" onclick="openPhonePe()">

                               <i class="fa-solid fa-mobile-screen-button"></i>
                                        PhonePe

                            </button>

                            <button type="button" class="pay-btn whatsapp" onclick="openWhatsApp()">

                                <i class="fa-brands fa-whatsapp"></i>

                                WhatsApp

                            </button>

                        </div>

                        <a href="https://forms.gle/r5UYrCbEHFmVqCTY6" target="_blank" class="upload-btn">

                            <i class="fa-solid fa-upload"></i>

                            Upload Screenshot

                        </a>

                    </div>

                </div>

            </div>
           <h4 class="payment-note">
    You can also upload your payment screenshot on WhatsApp
</h4>

            <hr>

            <!-- ================= ORDER DETAILS ================= -->

            <div class="order-section">

                <h2>Order Details</h2>

                <form id="orderForm">

                    <input type="hidden" name="access_key" value="1f937280-f43a-482b-b121-466444023e0f">

                    <input type="hidden" name="orderData" id="orderData">

                    <input type="hidden" name="total" id="totalAmount">

                    <div class="form-group">

                        <label>Your Order</label>

                        <div id="order-summary">

                            <!-- JS se automatically fill hoga -->

                        </div>

                    </div>

                    <!-- ================= CUSTOMER DETAILS ================= -->

                    <div class="form-group">

                        <label>Full Name</label>

                        <input type="text" name="name" placeholder="Enter Full Name"
                           
                            required>

                    </div>
                    <div class="form-group">
                       
                    <input
    type="hidden"
    name="phone"
    value="<%= currentUser.address.phone %>">
    </div>

<input
    type="hidden"
    name="address"
    value="<%= currentUser.address.addressLine %>">

                  
                   

                    <!-- ================= PAYMENT METHOD ================= -->

                    <div class="form-group">

                        <label>Payment Method</label>

                        <select name="paymentMethod" required>

                            <option value="">Select Payment Method</option>

                            <option value="Cash on Delivery">
                                Cash on Delivery
                            </option>

                            <option value="UPI">
                                UPI Payment
                            </option>

                        </select>

                    </div>

                    <!-- ================= TOTAL ================= -->

                    <div class="grand-total">

                        <h3>

                            Total Amount :
                            <span id="grandTotal">₹0</span>

                        </h3>

                    </div>

                    <!-- ================= PLACE ORDER ================= -->

                    <button type="submit" class="order-btn">

                        <i class="fa-solid fa-bag-shopping"></i>

                        Place Order

                    </button>

                </form>

            </div>

            <%- include("../partials/footer") %>
            <script src="/js/payment.js"></script>


              
                

</body>

</html>