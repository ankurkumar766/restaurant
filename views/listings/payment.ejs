<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>AR Food | Payment</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

    <!-- Cashfree JS SDK -->
    <script src="https://sdk.cashfree.com/js/v3/cashfree.js"></script>

    <!-- Your existing payment CSS -->
    <link
        rel="stylesheet"
        href="/css/payment.css"
    >
     <link rel="stylesheet" href="/css/footer.css">
      <link rel="stylesheet" href="/css/nav.css">
       <link rel="stylesheet" href="/css/marquee.css">


</head>


<body>
    
    <%- include("../partials/marquee") %>


    <!-- ================= NAVBAR ================= -->

    <%- include("../partials/nav") %>


    <!-- ================= MAIN ================= -->

    <main class="payment-page">

        <div class="container">

            <div class="checkout-wrapper">


                <!-- ================= ORDER CARD ================= -->

                <div class="checkout-card order-card">


                    <!-- HEADING -->

                    <div class="card-heading">

                        <div class="heading-icon order-icon">

                            <i class="fa-solid fa-bag-shopping"></i>

                        </div>

                        <div>

                            <span>Your Order</span>

                            <h2>Order Summary</h2>

                        </div>

                    </div>


                    <!-- ================= FORM ================= -->

                    <form id="orderForm">


                        <!-- ================= HIDDEN DATA ================= -->

                        <input
                            type="hidden"
                            name="orderData"
                            id="orderData"
                        >


                        <input
                            type="hidden"
                            name="total"
                            id="totalAmount"
                        >


                        <input
                            type="hidden"
                            name="paymentMethod"
                            id="paymentMethodHidden"
                        >


                        <!-- Cashfree order id -->

                        <input
                            type="hidden"
                            name="cashfreeOrderId"
                            id="cashfreeOrderId"
                        >


                        <!-- ================= ORDER SUMMARY ================= -->

                        <div class="form-group">

                            <label>

                                <i class="fa-solid fa-receipt"></i>

                                Your Items

                            </label>


                            <div id="order-summary">

                                <!-- payment.js fills this -->

                            </div>

                        </div>


                        <!-- ================= CUSTOMER DETAILS ================= -->

                        <div class="customer-section">


                            <h3>

                                <i class="fa-solid fa-user"></i>

                                Customer Details

                            </h3>


                            <!-- NAME -->

                            <div class="form-group">

                                <label>
                                    Full Name
                                </label>


                                <div class="input-wrapper">

                                    <i class="fa-solid fa-user"></i>

                                    <input
                                        type="text"
                                        name="name"
                                        placeholder="Enter your full name"
                                        value="<%= currentUser.name || '' %>"
                                        required
                                    >

                                </div>

                            </div>


                            <!-- PHONE -->

                            <input
                                type="hidden"
                                name="phone"
                                value="<%= currentUser.address?.phone || '' %>"
                            >


                            <!-- ADDRESS -->

                            <input
                                type="hidden"
                                name="address"
                                value="<%= currentUser.address?.addressLine || '' %>"
                            >


                            <!-- EMAIL -->

                            <input
                                type="hidden"
                                name="email"
                                value="<%= currentUser.email || '' %>"
                            >


                        </div>


                        <!-- ================= PAYMENT METHOD ================= -->

                        <div class="form-group payment-select-group">


                            <label>

                                <i class="fa-solid fa-credit-card"></i>

                                Select Payment Method

                            </label>


                            <div class="select-wrapper">

                                <i class="fa-solid fa-wallet"></i>


                                <select
                                    id="paymentMethod"
                                    required
                                >

                                    <option value="">
                                        Select Payment Method
                                    </option>


                                    <option value="Cash on Delivery">

                                        💵 Cash on Delivery

                                    </option>


                                    <option value="UPI">

                                        ⚡ Online Payment / UPI

                                    </option>

                                </select>


                                <i class="fa-solid fa-chevron-down arrow"></i>

                            </div>

                        </div>


                        <!-- ================= CASHFREE STATUS ================= -->

                        <div
                            id="upiPaymentStatus"
                            class="upi-payment-status"
                            style="display:none;"
                        >

                            <div class="upi-status-icon">

                                <i class="fa-solid fa-shield-halved"></i>

                            </div>


                            <div class="upi-status-content">

                                <strong>
                                    Secure Online Payment
                                </strong>

                                <p>

                                    You will be redirected to
                                    Cashfree's secure payment checkout.

                                </p>

                            </div>

                        </div>


                        <!-- ================= GRAND TOTAL ================= -->

                        <div class="grand-total">


                            <div>

                                <span>
                                    Total Amount
                                </span>


                                <small>
                                    Including all charges
                                </small>

                            </div>


                            <h3>

                                ₹<span id="grandTotal">0.00</span>

                            </h3>

                        </div>


                        <!-- ================= ORDER BUTTON ================= -->

                        <button
                            type="submit"
                            class="order-btn"
                            id="orderButton"
                        >

                            <span>

                                <i class="fa-solid fa-bag-shopping"></i>

                                Place Order

                            </span>


                            <i class="fa-solid fa-arrow-right"></i>

                        </button>


                        <!-- ================= SECURITY ================= -->

                        <div class="order-secure">

                            <i class="fa-solid fa-shield-halved"></i>

                            Safe & Secure Payment

                        </div>


                    </form>


                </div>


            </div>

        </div>

    </main>


    <!-- ================= FOOTER ================= -->

    <%- include("../partials/footer") %>


    <!-- ================= PAYMENT JS ================= -->

    <script src="/js/payment.js"></script>


</body>

</html>