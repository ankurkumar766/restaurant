<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Delivery Address</title>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <link rel="stylesheet" href="/css/nav.css">

    <link rel="stylesheet" href="/css/footer.css">

    <link rel="stylesheet" href="/css/addres.css">

    <link rel="icon"
        type="image/x-icon"
        href="/images/rest.png">

</head>


<body>


    <%- include("../partials/nav") %>


    <div class="container mt-5">

        <div class="address-box">

            <h2>

                <i class="fa-solid fa-location-dot"></i>

                Delivery Address

            </h2>


            <form id="addressForm">


                <!-- ================= FULL NAME ================= -->

                <div class="form-group">

                    <label>
                        Full Name
                    </label>

                    <input
                        type="text"
                        name="name"
                        value="<%= currentUser && currentUser.address ? currentUser.address.fullName : '' %>"
                        required
                    >

                </div>



                <!-- ================= PHONE ================= -->

                <div class="form-group">

                    <label>
                        Phone Number
                    </label>

                    <input
                        type="text"
                        name="phone"
                        value="<%= currentUser && currentUser.address ? currentUser.address.phone : '' %>"
                        required
                    >

                </div>



                <!-- ================= ADDRESS ================= -->

                <div class="form-group">

                    <label>
                        Delivery Address
                    </label>

                    <textarea
                        id="address"
                        name="address"
                        rows="4"
                        placeholder="House No, Street, Area, Domchanch, Koderma"
                        required
                    ><%= currentUser && currentUser.address ? currentUser.address.addressLine : '' %></textarea>

                </div>



                <!-- ================= MESSAGE ================= -->

                <p id="locationMessage"></p>



                <!-- ================= CONTINUE ================= -->

                <button
                    type="submit"
                    id="continueBtn"
                    class="btn btn-success"
                >

                    Continue To Payment →

                </button>


            </form>

        </div>

    </div>


    <%- include("../partials/footer") %>


    <script src="/js/address.js"></script>


</body>

</html>