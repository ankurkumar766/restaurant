<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login | Restaurants</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- CSS Files -->
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/marquee.css">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/rest.png">

</head>


<body>


    <!-- SUCCESS MESSAGE -->

    <% if(success && success.length > 0) { %>

        <div class="alert-message success-message">

            <i class="fa-solid fa-circle-check"></i>

            <%= success %>

        </div>

    <% } %>


    <!-- ERROR MESSAGE -->

    <% if(error && error.length > 0) { %>

        <div class="alert-message error-message">

            <i class="fa-solid fa-circle-exclamation"></i>

            <%= error %>

        </div>

    <% } %>


    <!-- LOGIN SECTION -->

    <main class="login-section">


        <div class="login-container">


            <!-- LEFT SIDE -->

            <div class="login-image">


                <div class="overlay">


                    <!-- BRAND -->

                    <div class="brand">

                        <div class="brand-icon">

                            <i class="fa-solid fa-utensils"></i>

                        </div>

                        <h1>Restaurants</h1>

                    </div>


                    <!-- WELCOME TEXT -->

                    <div class="welcome-text">

                        <h2>
                            Welcome Back!
                        </h2>

                        <p>
                            Login to explore delicious food,
                            manage your orders and enjoy your
                            favorite restaurants.
                        </p>

                    </div>


                </div>

            </div>



            <!-- RIGHT SIDE -->

            <div class="login-form-container">


                <div class="form-header">

                    <h2>Login</h2>

                    <p>
                        Welcome back! Please enter your details.
                    </p>

                </div>



                <!-- LOGIN FORM -->

                <form
                    action="/login"
                    method="post"
                    class="login-form needs-validation"
                    novalidate
                >


                    <!-- USERNAME -->

                    <div class="input-group">

                        <label for="username">
                            Username
                        </label>


                        <div class="input-box">

                            <i class="fa-solid fa-user"></i>

                            <input
                                name="username"
                                id="username"
                                type="text"
                                placeholder="Enter your username"
                                required
                            >

                        </div>

                    </div>



                    <!-- PASSWORD -->

                    <div class="input-group">

                        <label for="password">
                            Password
                        </label>


                        <div class="input-box password-box">

                            <i class="fa-solid fa-lock"></i>

                            <input
                                name="password"
                                id="password"
                                type="password"
                                placeholder="Enter your password"
                                required
                            >


                            <!-- EYE ICON -->

                            <i
                                class="fa-solid fa-eye password-toggle"
                                id="togglePassword"
                            ></i>

                        </div>

                    </div>



                    <!-- OPTIONS -->

                    <div class="login-options">


                        <!-- SHOW PASSWORD -->

                        <label class="checkbox-container">

                            <input
                                type="checkbox"
                                id="show-password-checkbox"
                            >

                            <span></span>

                            Show Password

                        </label>



                        <!-- FORGOT PASSWORD -->

                        <a
                            href="/forgot"
                            class="forgot-password"
                        >
                            Forgot Password?
                        </a>


                    </div>



                    <!-- LOGIN BUTTON -->

                    <button
                        type="submit"
                        class="login-btn"
                    >

                        <span>Login</span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </button>



                    <!-- SIGNUP LINK -->

                    <div class="signup-link">

                        <p>

                            Don't have an account?

                            <a href="/signup">
                                Create Account
                            </a>

                        </p>

                    </div>


                </form>


            </div>


        </div>


    </main>



    <!-- FOOTER -->

    <%- include("../partials/footer") %>



    <script>

        const passwordInput =
            document.getElementById("password");

        const showPasswordCheckbox =
            document.getElementById("show-password-checkbox");

        const togglePassword =
            document.getElementById("togglePassword");


        // Checkbox Password Show / Hide

        showPasswordCheckbox.addEventListener(
            "change",
            function () {

                if (this.checked) {

                    passwordInput.type = "text";

                    togglePassword.classList.remove("fa-eye");

                    togglePassword.classList.add("fa-eye-slash");

                } else {

                    passwordInput.type = "password";

                    togglePassword.classList.remove("fa-eye-slash");

                    togglePassword.classList.add("fa-eye");

                }

            }
        );


        // Eye Icon Password Show / Hide

        togglePassword.addEventListener(
            "click",
            function () {

                if (passwordInput.type === "password") {

                    passwordInput.type = "text";

                    togglePassword.classList.remove("fa-eye");

                    togglePassword.classList.add("fa-eye-slash");

                    showPasswordCheckbox.checked = true;

                } else {

                    passwordInput.type = "password";

                    togglePassword.classList.remove("fa-eye-slash");

                    togglePassword.classList.add("fa-eye");

                    showPasswordCheckbox.checked = false;

                }

            }
        );

    </script>


</body>

</html>