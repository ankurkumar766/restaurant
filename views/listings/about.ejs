<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>About Us | Vatika The Family Restaurant</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <link rel="stylesheet" href="/css/nav.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/marquee.css">
    <link rel="stylesheet" href="/css/about.css">
     <link rel="icon" type="image/x-icon" href="/images/rest.png">  
</head>

<body>

    <%- include("../partials/marquee") %>
    <%- include("../partials/nav") %>

    <!-- Hero -->
    <section class="about-hero">

        <div class="overlay"></div>

        <div class="hero-content">
            <h1>About AR Restaurant</h1>
            <p>
                Delicious Food • Warm Hospitality • Memorable Moments
            </p>

            <a href="#about" class="hero-btn">
                Explore
            </a>

        </div>

    </section>

    <!-- About -->

    <section class="about-section" id="about">

        <div class="container">

            <div class="about-image">

                <img src="/images/food1.jfif" alt="Restaurant">

            </div>

            <div class="about-content">

                <span>ABOUT US</span>

                <h2>Welcome to AR The Family Restaurant</h2>

                <p>
                    AR is a family restaurant dedicated to serving fresh,
                    hygienic and delicious food. Whether you're planning a
                    family dinner, birthday celebration or a quick lunch,
                    we ensure every meal is prepared with quality ingredients
                    and served with care.
                </p>

                <p>
                    We offer Indian, Chinese, Fast Food, Veg and Non-Veg
                    specialties prepared by experienced chefs in a clean
                    and comfortable environment.
                </p>

                <div class="features">

                    <div>
                        <i class="fa-solid fa-utensils"></i>
                        <span>80+ Delicious Dishes</span>
                    </div>

                    <div>
                        <i class="fa-solid fa-bowl-food"></i>
                        <span>Fresh Ingredients</span>
                    </div>

                    <div>
                        <i class="fa-solid fa-truck"></i>
                        <span>Fast Delivery</span>
                    </div>

                    <div>
                        <i class="fa-solid fa-heart"></i>
                        <span>Family Friendly</span>
                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- Stats -->

    <section class="stats">

        <div class="box">
            <h2>500+</h2>
            <p>Happy Customers</p>
        </div>

        <div class="box">
            <h2>80+</h2>
            <p>Menu Items</p>
        </div>

        <div class="box">
            <h2>5★</h2>
            <p>Customer Rating</p>
        </div>

        <div class="box">
            <h2>24×7</h2>
            <p>Online Support</p>
        </div>

    </section>

    <!-- Why Choose -->

    <section class="why-us">

        <h2>Why Choose Us?</h2>

        <div class="cards">

            <div class="card">
                <i class="fa-solid fa-seedling"></i>
                <h3>Fresh Food</h3>
                <p>Prepared daily using quality ingredients.</p>
            </div>

            <div class="card">
                <i class="fa-solid fa-user-group"></i>
                <h3>Family Atmosphere</h3>
                <p>Perfect place for family and friends.</p>
            </div>

            <div class="card">
                <i class="fa-solid fa-motorcycle"></i>
                <h3>Quick Delivery</h3>
                <p>Fast and reliable doorstep delivery.</p>
            </div>

        </div>

    </section>

    <!-- Map -->

    <section class="location">

        <h2>Find Us</h2>

        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3665.422726323363!2d85.77372607510464!3d24.34592147829576!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39f2a9a3d5f5d4c1%3A0x4a9f21b66c83d71a!2sVATIKA%20The%20Family%20Restaurant!5e0!3m2!1sen!2sin!4v1726847274000!5m2!1sen!2sin"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
        </iframe>

    </section>

    <%- include("../partials/footer") %>

</body>

</html>