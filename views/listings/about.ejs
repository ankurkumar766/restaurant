<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">

```
<title>About Us | AR Food</title>

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

<link rel="stylesheet" href="/css/nav.css">
<link rel="stylesheet" href="/css/footer.css">
<link rel="stylesheet" href="/css/marquee.css">
<link rel="stylesheet" href="/css/about.css">

<link rel="icon" type="image/x-icon" href="/images/rest.png">
```

</head>

<body>

```
<%- include("../partials/marquee") %>

<%- include("../partials/nav") %>

<!-- Hero -->

<section class="about-hero">

    <div class="overlay"></div>

    <div class="hero-content">

        <h1>About AR Food</h1>

        <p>
            Your Favourite Food, Delivered to Your Door
        </p>

        <a href="#about" class="hero-btn">
            Explore
        </a>

    </div>

</section>


<!-- About -->

<section class="about-section" id="about">

    <div class="container">

        <div class="about-image">

            <img src="/images/food1.jfif" alt="Delicious Food">

        </div>

        <div class="about-content">

            <span>ABOUT US</span>

            <h2>Welcome to AR Food</h2>

            <p>

                AR Food is an online food ordering website created to make
                your favourite food easily accessible. Browse our menu,
                choose your favourite dishes and place your order from
                the comfort of your home.

            </p>

            <p>

                We bring together a variety of Indian, Chinese and Fast
                Food options in one place. Our goal is to provide a
                simple, convenient and enjoyable online food ordering
                experience.

            </p>

            <div class="features">

                <div>

                    <i class="fa-solid fa-utensils"></i>

                    <span>Wide Food Selection</span>

                </div>

                <div>

                    <i class="fa-solid fa-mobile-screen-button"></i>

                    <span>Easy Online Ordering</span>

                </div>

                <div>

                    <i class="fa-solid fa-cart-shopping"></i>

                    <span>Simple Checkout</span>

                </div>

                <div>

                    <i class="fa-solid fa-heart"></i>

                    <span>Made for Food Lovers</span>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Stats -->

<section class="stats">

    <div class="box">

        <h2>80+</h2>

        <p>Food Items</p>

    </div>

    <div class="box">

        <h2>24/7</h2>

        <p>Online Access</p>

    </div>

    <div class="box">

        <h2>Easy</h2>

        <p>Food Ordering</p>

    </div>

    <div class="box">

        <h2>100%</h2>

        <p>Online Experience</p>

    </div>

</section>


<!-- Why Choose -->

<section class="why-us">

    <h2>Why Choose AR Food?</h2>

    <div class="cards">

        <div class="card">

            <i class="fa-solid fa-magnifying-glass"></i>

            <h3>Explore Menu</h3>

            <p>
                Discover different food items and choose what you love.
            </p>

        </div>

        <div class="card">

            <i class="fa-solid fa-cart-shopping"></i>

            <h3>Easy Ordering</h3>

            <p>
                Add your favourite dishes to cart and place your order
                online.
            </p>

        </div>

        <div class="card">

            <i class="fa-solid fa-mobile-screen-button"></i>

            <h3>Order from Anywhere</h3>

            <p>
                Enjoy a convenient food ordering experience on your
                mobile or computer.
            </p>

        </div>

    </div>

</section>


<!-- Online Platform -->

<section class="location">

    <h2>Order Your Favourite Food</h2>

    <p>
        Explore our menu and place your order online.
    </p>

    <a href="/" class="hero-btn">
        Explore Menu
    </a>

</section>


<%- include("../partials/footer") %>
```

</body>

</html>
