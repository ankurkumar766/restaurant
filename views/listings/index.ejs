<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AR Food | Delicious Food Delivered Fast</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <!-- Google Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/marquee.css">
    <link rel="stylesheet" href="/css/nav.css">

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#ff6b00">

    <link rel="icon" type="image/x-icon" href="/images/food1.jfif">
</head>


<body>

    <!-- ================= MARQUEE ================= -->

    <%- include("../partials/marquee") %>


    <!-- ================= NAVBAR ================= -->

    <nav class="navbar">

        <div class="container nav-container">

            <!-- Logo -->

            <a href="/listings" class="logo">

                <div class="logo-icon">
                    <i class="fa-solid fa-utensils"></i>
                </div>

                <div class="logo-text">

                    <span>AR</span> Food

                    <small>Fresh & Delicious</small>

                </div>

            </a>


            <!-- Search -->

            <div class="search-box">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input
                    type="text"
                    id="searchInput"
                    placeholder="Search your favourite food..."
                >

            </div>


            <!-- Menu -->

            <div class="menu-items">

                <% if(!currentUser){ %>

                    <a href="/signup">

                        <i class="fa-solid fa-user-plus"></i>

                        <span>Signup</span>

                    </a>


                    <a href="/login">

                        <i class="fa-solid fa-right-to-bracket"></i>

                        <span>Login</span>

                    </a>


                    <a href="/about">

                        <i class="fa-solid fa-circle-info"></i>

                        <span>About</span>

                    </a>

                <% } %>


                <% if(currentUser){ %>

                    <%- include("../partials/nav") %>

                <% } %>

            </div>

        </div>

    </nav>



    <!-- ================= HERO SECTION ================= -->

    <section class="hero">

        <div class="hero-overlay"></div>


        <div class="container hero-content">

            <div class="hero-badge">

                <i class="fa-solid fa-fire"></i>

                Fresh • Hot • Delicious

            </div>


            <h1>

                Delicious Food

                <span>Delivered To You</span>

            </h1>


            <p>

                Craving something delicious? Explore your favourite dishes
                and get fresh food delivered quickly to your doorstep.

            </p>


            <div class="hero-buttons">

                <a href="#menu" class="btn-order">

                    <i class="fa-solid fa-bowl-food"></i>

                    Explore Menu

                </a>


                <a href="#about" class="btn-about">

                    <i class="fa-solid fa-circle-info"></i>

                    Know More

                </a>

            </div>


            <div class="hero-features">

                <div>

                    <i class="fa-solid fa-truck-fast"></i>

                    <span>Fast Delivery</span>

                </div>


                <div>

                    <i class="fa-solid fa-leaf"></i>

                    <span>Fresh Food</span>

                </div>


                <div>

                    <i class="fa-solid fa-location-dot"></i>

                    <span>Within 5 KM</span>

                </div>

            </div>

        </div>


        <!-- Slider Dots -->

        <div class="slider-indicators">

            <span class="active"></span>

            <span></span>

            <span></span>

        </div>

    </section>



    <!-- ================= POPULAR MENU ================= -->

    <section class="menu-section" id="menu">

        <div class="container">


            <!-- Heading -->

            <div class="section-heading">

                <div class="section-tag">

                    <i class="fa-solid fa-star"></i>

                    Popular Choices

                </div>


                <h2>

                    Explore Our

                    <span>Delicious Menu</span>

                </h2>


                <p>

                    Freshly prepared food made with quality ingredients
                    and delivered with love ❤️

                </p>

            </div>



            <!-- Food Cards -->

           <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4 g-lg-5">


                <% for(let listing of allListings){ %>


                    <div class="col">

                        <div class="food-card">


                            <!-- Image -->

                            <div class="food-image">

                                <img
                                    src="<%= listing.image.url %>"
                                    alt="<%= listing.title %>"
                                >


                                <!-- Rating -->

                                <%
                                    let highestRating = null;

                                    if(listing.reviews && listing.reviews.length > 0){

                                        highestRating = Math.max(
                                            ...listing.reviews.map(
                                                review => Number(review.rating)
                                            )
                                        );

                                    }
                                %>


                                <div class="rating-badge">

                                    <i class="fa-solid fa-star"></i>

                                    <span>

                                        <%= highestRating !== null ? highestRating : "New" %>

                                    </span>

                                </div>


                                <div class="food-image-overlay"></div>

                            </div>



                            <!-- Card Body -->

                            <div class="food-body">


                                <h3 class="card-title">

                                    <%= listing.title %>

                                </h3>


                                <p class="food-desc">

                                    Freshly prepared and served hot
                                    for the best taste.

                                </p>



                                <!-- Size -->

                                <div class="size-title">

                                    <span>Select Size</span>

                                </div>


                                <div class="size-buttons">


                                    <button
                                        type="button"
                                        class="size-btn active"
                                        data-type="Half"
                                        data-price="<%= listing.halfPrice %>"
                                    >

                                        Half

                                    </button>



                                    <button
                                        type="button"
                                        class="size-btn"
                                        data-type="Full"
                                        data-price="<%= listing.fullPrice %>"
                                    >

                                        Full

                                    </button>


                                </div>



                                <!-- Price -->

                                <div class="price-row">

                                    <div>

                                        <small>Starting from</small>

                                        <h4 class="price">

                                            ₹<span class="food-price">

                                                <%= listing.halfPrice %>

                                            </span>

                                        </h4>

                                    </div>


                                    <div class="veg-icon">

                                        <span></span>

                                    </div>

                                </div>



                                <!-- Buttons -->

                                <div class="food-actions">


                                    <a
                                        href="/listings/<%= listing._id %>"
                                        class="view-btn"
                                    >

                                        <i class="fa-regular fa-eye"></i>

                                        View

                                    </a>



                                    <% if(!currentUser){ %>


                                        <a
                                            href="/signup"
                                            class="cart-btn"
                                        >

                                            <i class="fa-solid fa-cart-shopping"></i>

                                        </a>


                                    <% } %>



                                    <% if(currentUser){ %>


                                        <form
                                            action="/cart/<%= listing._id %>"
                                            method="POST"
                                            class="cart-form"
                                        >


                                            <input
                                                type="hidden"
                                                name="variation"
                                                class="variationInput"
                                                value="Half"
                                            >


                                            <input
                                                type="hidden"
                                                name="price"
                                                class="priceInput"
                                                value="<%= listing.halfPrice %>"
                                            >


                                            <button
                                                type="submit"
                                                class="cart-btn"
                                            >

                                                <i class="fa-solid fa-cart-shopping"></i>

                                            </button>


                                        </form>


                                    <% } %>


                                </div>


                            </div>

                        </div>

                    </div>


                <% } %>


            </div>

        </div>

    </section>



    <!-- ================= WHY CHOOSE US ================= -->

    <section class="why-section">

        <div class="container">

            <div class="section-heading light-heading">

                <div class="section-tag">

                    <i class="fa-solid fa-heart"></i>

                    Why Choose Us

                </div>


                <h2>

                    More Than Just

                    <span>Great Food</span>

                </h2>

            </div>


            <div class="row g-4">


                <div class="col-md-4">

                    <div class="why-card">

                        <div class="why-icon">

                            <i class="fa-solid fa-bowl-food"></i>

                        </div>

                        <h3>Fresh Food</h3>

                        <p>

                            Every dish is freshly prepared
                            with quality ingredients.

                        </p>

                    </div>

                </div>



                <div class="col-md-4">

                    <div class="why-card">

                        <div class="why-icon">

                            <i class="fa-solid fa-truck-fast"></i>

                        </div>

                        <h3>Fast Delivery</h3>

                        <p>

                            Your favourite food delivered
                            quickly and safely.

                        </p>

                    </div>

                </div>



                <div class="col-md-4">

                    <div class="why-card">

                        <div class="why-icon">

                            <i class="fa-solid fa-face-smile"></i>

                        </div>

                        <h3>Happy Customers</h3>

                        <p>

                            Delicious food and a service
                            designed to make you smile.

                        </p>

                    </div>

                </div>


            </div>

        </div>

    </section>



    <!-- ================= ABOUT ================= -->

    <section id="about" class="about-section">

        <div class="container">

            <div class="row align-items-center g-5">


                <div class="col-lg-6">

                    <div class="about-image">

                        <img
                            src="/images/food1.jfif"
                            alt="AR Food Restaurant"
                        >

                        <div class="experience-box">

                            <strong>1+</strong>

                            <span>Year of<br>Delicious Food</span>

                        </div>

                    </div>

                </div>



                <div class="col-lg-6">

                    <div class="about-text">


                        <div class="section-tag">

                            <i class="fa-solid fa-utensils"></i>

                            About AR Food

                        </div>


                        <h2>

                            Delicious Food,

                            <span>Made With Love</span>

                        </h2>


                        <p>

                            In our restaurant, we serve fresh and delicious
                            food with a wide variety of Indian, Chinese,
                            and Continental dishes.

                        </p>


                        <p>

                            A comfortable ambiance, quick service and
                            affordable prices are the highlights of our place.
                            It’s the perfect spot to enjoy with family,
                            friends and make special occasions memorable.

                        </p>


                        <div class="about-points">

                            <div>

                                <i class="fa-solid fa-check"></i>

                                Fresh Ingredients

                            </div>


                            <div>

                                <i class="fa-solid fa-check"></i>

                                Fast Service

                            </div>


                            <div>

                                <i class="fa-solid fa-check"></i>

                                Affordable Prices

                            </div>


                        </div>


                        <a href="#menu" class="btn-order">

                            Explore Food

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>


                    </div>

                </div>


            </div>

        </div>

    </section>



    <!-- ================= ADDRESS ================= -->

    <section class="address-section">

        <div class="container">

            <div class="address-card">


                <div class="address-info">

                    <div class="address-icon">

                        <i class="fa-solid fa-location-dot"></i>

                    </div>


                    <div>

                        <span>Visit Our Restaurant</span>

                        <h2>AR The Family Restaurant</h2>

                        <p>

                            Mahthadih, Domchanch,
                            Koderma – 825418

                        </p>

                    </div>

                </div>


                <div class="map-wrapper">

                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3665.422726323363!2d85.77372607510464!3d24.34592147829576!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39f2a9a3d5f5d4c1%3A0x4a9f21b66c83d71a!2sVATIKA%20The%20Family%20Restaurant!5e0!3m2!1sen!2sin!4v1726847274000!5m2!1sen!2sin"
                        width="100%"
                        height="400"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                    ></iframe>

                </div>

            </div>

        </div>

    </section>



    <!-- ================= AI ASSISTANT ================= -->

    <div id="aiAssistant">

        <a href="/chat">

            <img
                src="/images/ai.png"
                alt="AI Assistant"
            >

        </a>

    </div>



    <!-- ================= FOOTER ================= -->

    <%- include("../partials/footer") %>



    <!-- ================= SEARCH SCRIPT ================= -->

    <script>

        const searchInput = document.getElementById("searchInput");

        searchInput.addEventListener("keyup", function () {

            const query = this.value.trim().toLowerCase();

            const cards = document.querySelectorAll(".food-card");

            cards.forEach(card => {

                const title = card
                    .querySelector(".card-title")
                    .textContent
                    .toLowerCase();

                const price = card
                    .querySelector(".price")
                    .textContent
                    .replace(/[₹,\s]/g, "");


                if (!isNaN(query) && query !== "") {

                    if (parseInt(price) <= parseInt(query)) {

                        card.closest(".col").style.display = "";

                    } else {

                        card.closest(".col").style.display = "none";

                    }

                }

                else {

                    if (
                        title.includes(query) ||
                        price.includes(query)
                    ) {

                        card.closest(".col").style.display = "";

                    } else {

                        card.closest(".col").style.display = "none";

                    }

                }

            });

        });

    </script>



    <!-- ================= AI DRAG ================= -->

    <script>

        const assistant = document.getElementById("aiAssistant");

        let isDragging = false;

        let offsetX;

        let offsetY;


        assistant.addEventListener("mousedown", (e) => {

            isDragging = true;

            offsetX = e.clientX - assistant.offsetLeft;

            offsetY = e.clientY - assistant.offsetTop;

        });


        document.addEventListener("mousemove", (e) => {

            if (!isDragging) return;

            const x = e.clientX - offsetX;

            const y = e.clientY - offsetY;

            assistant.style.left = x + "px";

            assistant.style.top = y + "px";

            assistant.style.right = "auto";

            assistant.style.bottom = "auto";

        });


        document.addEventListener("mouseup", () => {

            isDragging = false;

        });



        /* Mobile */

        assistant.addEventListener("touchstart", (e) => {

            isDragging = true;

            const touch = e.touches[0];

            offsetX = touch.clientX - assistant.offsetLeft;

            offsetY = touch.clientY - assistant.offsetTop;

        });


        document.addEventListener("touchmove", (e) => {

            if (!isDragging) return;

            const touch = e.touches[0];

            assistant.style.left =
                (touch.clientX - offsetX) + "px";

            assistant.style.top =
                (touch.clientY - offsetY) + "px";

            assistant.style.right = "auto";

            assistant.style.bottom = "auto";

        });


        document.addEventListener("touchend", () => {

            isDragging = false;

        });

    </script>



    <!-- ================= HALF FULL SCRIPT ================= -->

    <script>

        document
            .querySelectorAll(".food-card")
            .forEach(card => {

                const buttons =
                    card.querySelectorAll(".size-btn");

                const foodPrice =
                    card.querySelector(".food-price");

                const variationInput =
                    card.querySelector(".variationInput");

                const priceInput =
                    card.querySelector(".priceInput");


                buttons.forEach(btn => {

                    btn.addEventListener(
                        "click",
                        function () {

                            buttons.forEach(b =>
                                b.classList.remove("active")
                            );

                            this.classList.add("active");


                            foodPrice.innerText =
                                this.dataset.price;


                            if (variationInput) {

                                variationInput.value =
                                    this.dataset.type;

                            }


                            if (priceInput) {

                                priceInput.value =
                                    this.dataset.price;

                            }

                        }
                    );

                });

            });

    </script>


</body>

</html>