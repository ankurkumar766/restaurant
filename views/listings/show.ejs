<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restaurants</title>
    <!-- Font Awesome CDN include karo -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
        integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/css/show.css" />
    <link rel="stylesheet" href="/css/marquee.css">
    <link rel="stylesheet" href="/css/nav.css">

</head>

<body>
    <%- include("../partials/marquee") %>
       
        <!-- <%- include("../partials/nav") %> -->
          <a href="/" 
       style="font-size:24px;color:#2563eb;text-decoration:none;
              width:42px;height:42px;background:#f1f5f9;
              border-radius:50%;display:flex;
              align-items:center;justify-content:center;
              transition:.3s;">

        <i class="fas fa-arrow-left"></i>

    </a>
            <h3 style="color: blue;">Munu Details:- </h3>
            <div class="row">
                <div class="col-8 offest-2">


                    <h3>
                        <%= listing.title %> :
                    </h3>
                </div>
                <div class=" card col-6 offset-2 show-card listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
                    <div class="card-body">
                        <p class="card-text">

                            <b>
                                <%= listing.title %>
                        </p> </b>

                    </div>
                </div>
                <!-- <ul>
                    <li>
                        <%= listing.title %>
                    </li>

                    <br />
                    <li>
                        <%= listing.description %>
                    </li>
                    <li> &#8377; <%= listing.price.toLocaleString("en-IN") %>
                    </li>


                </ul> -->
                <ul>

    <li>
        <%= listing.title %>
    </li>

    <br>

    <li>
        <%= listing.description %>
    </li>

  <div class="size-buttons">
    <button type="button" id="halfBtn" class="size-btn active">
        Half
    </button>

    <button type="button" id="fullBtn" class="size-btn">
        Full
    </button>
</div>
<li style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">

    <span id="foodPrice" style="font-size:22px;font-weight:bold;color:#16a34a;">
        ₹<%= listing.halfPrice.toLocaleString("en-IN") %>
    </span>

</li>

</ul>


                <% if(!currentUser){ %>
                    <!-- <a class="nav-link " href="/signup"><b>Buy Now</b></a> -->
                    <a href="/signup" class="buy-btn">Buy Now</a>


                    <h1 style="color: #ff0000;">please signup for buy the food</h1>

                    <% } %>


                       <% if(currentUser){ %>

<div class="action-buttons">

   <form action="/cart/<%= listing._id %>" method="POST">

    <input
        type="hidden"
        name="variation"
        id="variation"
        value="Half"
    >

    <input
        type="hidden"
        name="price"
        id="selectedPrice"
        value="<%= listing.halfPrice %>"
    >

    <button class="add">
        Add to Bag 🛒
    </button>

</form>

    <a href="/listings/<%= listing._id %>/cancle" class="can-btn">
        Cancel
    </a>

</div>

<% } %>

<hr>
                                <h2 class="related-title">Related Menu 🍔</h2>
                                <!-- <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4 mt-3"> -->


                                <div class="related-container">

                                    <% relatedListings.forEach(item=> { %>

                                        <a href="/listings/<%= item._id %>" class="related-card-link">

                                            <div class="related-card">

                                                <img src="<%= item.image.url %>" class="related-img">

                                                <div class="related-body">

                                                    <h5>
                                                        <%= item.title %>
                                                    </h5>

                                                    <p>₹ <%= item.price.toLocaleString("en-IN") %>
                                                    </p>

                                                </div>


                                            </div>
                                            <!-- </div> -->

                                        </a>

                                        <% }) %>

                                </div>
                                <hr>

                                <div class="review-section">

                                    <h2 class="review-heading">
                                        ⭐ Customer Reviews
                                    </h2>

                                    <% if(currentUser){ %>

                                        <form action="/listings/<%= listing._id %>/reviews" method="POST">

                                            <div class="mb-4">

                                                <label class="form-label">Your Rating</label>

                                                <div class="star-rating">

                                                    <input type="radio" id="star5" name="review[rating]" value="5"
                                                        required>
                                                    <label for="star5">★</label>

                                                    <input type="radio" id="star4" name="review[rating]" value="4">
                                                    <label for="star4">★</label>

                                                    <input type="radio" id="star3" name="review[rating]" value="3">
                                                    <label for="star3">★</label>

                                                    <input type="radio" id="star2" name="review[rating]" value="2">
                                                    <label for="star2">★</label>

                                                    <input type="radio" id="star1" name="review[rating]" value="1">
                                                    <label for="star1">★</label>

                                                </div>

                                            </div>

                                            <div class="mb-3">

                                                <label class="form-label">
                                                    Write Review
                                                </label>

                                                <textarea name="review[comment]" rows="5" class="form-control"
                                                    placeholder="Share your experience..." required></textarea>

                                            </div>

                                            <button class="review-btn">

                                                Submit Review

                                            </button>

                                        </form>

                                        <% } else { %>

                                            <div class="login-message">

                                                Please Login to Write Review

                                            </div>

                                            <% } %>

                                </div>


                                <h2 class="all-review-title">

                                    Customer Reviews

                                </h2>

                                <% if(listing.reviews.length){ %>

                                    <% listing.reviews.forEach(review=>{ %>

                                        <div class="review-card">

                                            <div class="review-stars">

                                                <% for(let i=1;i<=5;i++){ %>

                                                    <% if(i<=review.rating){ %>

                                                        <span class="filled">★</span>

                                                        <% }else{ %>

                                                            <span>☆</span>

                                                            <% } %>

                                                                <% } %>

                                            </div>

                                            <p class="review-comment">

                                                <%= review.comment %>

                                            </p>

                                        </div>

                                        <% }) %>

                                            <% }else{ %>

                                                <p class="no-review">

                                                    No Reviews Yet.

                                                </p>

                                                <% } %><br><br>
                                                    <footer>
                                                        <div class="f-info">
                                                            <div class="f-info-socials">
                                                                <a <i href="https://www.facebook.com/share/19nyENzRAD/"
                                                                    class="fa-brands fa-facebook"
                                                                    style="font-size: 24px ;"></i>&nbsp; &nbsp; &nbsp;
                                                                </a>
                                                                <a <i
                                                                    href="https://www.instagram.com/invites/contact/?utm_source=ig_contact_invite&utm_medium=copy_link&utm_content=qpexvi5"
                                                                    class="fa-brands fa-square-instagram"
                                                                    style="font-size: 24px ;"></i>&nbsp; &nbsp;&nbsp;
                                                                </a>
                                                                <a <i
                                                                    href="https://youtube.com/@ankurkumar-3?si=JRHq2H5lawvXVejf "
                                                                    class="fa-brands fa-youtube"
                                                                    style="font-size: 24px ;"></i></a>

                                                            </div>
                                                            <div>
                                                                <p> <i class="fa-solid fa-phone-volume"></i> +91
                                                                    7667880272</p>
                                                                <p> <i class="fa-solid fa-envelope"></i>
                                                                    ankurkumar89632@gmail.com</p>
                                                            </div>
                                                            <div class="f-info-brand"> &copy; Wanderlust Private Limited
                                                            </div>

                                                            <div class="f-info-links">
                                                                <a href="/policy">Privacy</a>&nbsp;
                                                                <a href="/term">Terms</a>
                                                                <a href="/listings/<%= listing._id %>/edit">-</a>
                                                                <!-- <a href="/adminLogin.ejs">---</a> -->
                                                                <a href="<%= isAdmin ? '/admin/dashboard' : '/admin' %>">
                                                                              Admin
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </footer>

                                                    <script>

const halfBtn = document.getElementById("halfBtn");
const fullBtn = document.getElementById("fullBtn");

const foodPrice = document.getElementById("foodPrice");

const variation = document.getElementById("variation");
const selectedPrice = document.getElementById("selectedPrice");

halfBtn.addEventListener("click", () => {

    foodPrice.innerHTML = "₹<%= listing.halfPrice.toLocaleString('en-IN') %>";

    variation.value = "Half";
    selectedPrice.value = "<%= listing.halfPrice %>";

    halfBtn.classList.remove("btn-outline-danger");
    halfBtn.classList.add("btn-danger");

    fullBtn.classList.remove("btn-danger");
    fullBtn.classList.add("btn-outline-danger");

});

fullBtn.addEventListener("click", () => {

    foodPrice.innerHTML = "₹<%= listing.fullPrice.toLocaleString('en-IN') %>";

    variation.value = "Full";
    selectedPrice.value = "<%= listing.fullPrice %>";

    fullBtn.classList.remove("btn-outline-danger");
    fullBtn.classList.add("btn-danger");

    halfBtn.classList.remove("btn-danger");
    halfBtn.classList.add("btn-outline-danger");

});
halfBtn.addEventListener("click", () => {
    halfBtn.classList.add("active");
    fullBtn.classList.remove("active");
});

fullBtn.addEventListener("click", () => {
    fullBtn.classList.add("active");
    halfBtn.classList.remove("active");
});



</script>

</body>

</html>