<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= listing.title %> | Restaurants</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="/css/show.css">
    <link rel="stylesheet" href="/css/marquee.css">
    <link rel="stylesheet" href="/css/footer.css">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/images/rest.png">

</head>


<body>

    <!-- OPTIONAL: YOUR MARQUEE -->
    <%- include("../partials/marquee") %>


    <!-- =========================
         FOOD HERO SECTION
    ========================== -->

    <main class="food-page">

        <section class="food-hero">


            <!-- BACK BUTTON -->

            <a href="/" class="back-btn">

                <i class="fa-solid fa-arrow-left"></i>

            </a>


            <!-- FOOD IMAGE -->

            <div class="hero-image-wrapper">

                <img
                    src="<%= listing.image.url %>"
                    alt="<%= listing.title %>"
                    class="hero-food-image"
                >

            </div>


            <!-- FOOD DETAILS -->

            <div class="food-content">


                <div class="food-header">

                    <div>

                        <span class="food-category">

                            <i class="fa-solid fa-utensils"></i>

                            Fresh & Delicious

                        </span>


                        <h1>
                            <%= listing.title %>
                        </h1>

                    </div>


                    <div class="food-rating">

                        <i class="fa-solid fa-star"></i>

                        <span>
                            4.5
                        </span>

                    </div>

                </div>


                <!-- DESCRIPTION -->

                <p class="food-description">

                    <%= listing.description %>

                </p>


                <!-- DIVIDER -->

                <div class="food-divider"></div>


                <!-- SIZE SELECTOR -->

                <div class="size-section">

                    <h3>
                        Choose your size
                    </h3>


                    <div class="size-buttons">

                        <button
                            type="button"
                            id="halfBtn"
                            class="size-btn active"
                        >

                            <span class="size-name">
                                Half
                            </span>

                            <span class="size-price">

                                ₹<%= listing.halfPrice.toLocaleString("en-IN") %>

                            </span>

                        </button>


                        <button
                            type="button"
                            id="fullBtn"
                            class="size-btn"
                        >

                            <span class="size-name">
                                Full
                            </span>

                            <span class="size-price">

                                ₹<%= listing.fullPrice.toLocaleString("en-IN") %>

                            </span>

                        </button>

                    </div>

                </div>


                <!-- PRICE -->

                <div class="price-section">

                    <div>

                        <span class="price-text">
                            Total Price
                        </span>

                        <div id="foodPrice">

                            ₹<%= listing.halfPrice.toLocaleString("en-IN") %>

                        </div>

                    </div>


                    <div class="delivery-info">

                        <i class="fa-solid fa-bolt"></i>

                        <span>
                            Fast Delivery
                        </span>

                    </div>

                </div>


                <!-- =========================
                     NOT LOGGED IN
                ========================== -->

                <% if (!currentUser) { %>

                    <div class="guest-action">

                        <p>

                            <i class="fa-solid fa-circle-info"></i>

                            Login or signup to order this delicious food.

                        </p>


                        <a href="/signup" class="order-btn">

                            <i class="fa-solid fa-user-plus"></i>

                            Signup to Order

                        </a>

                    </div>

                <% } %>


                <!-- =========================
                     LOGGED IN
                ========================== -->

                <% if (currentUser) { %>

                    <div class="action-buttons">


                        <!-- ADD TO BAG -->

                        <form
                            action="/cart/<%= listing._id %>"
                            method="POST"
                            class="cart-form"
                        >

                            <input
                                type="hidden"
                                name="variation"
                                id="variation"
                                value="Half"
                            >


                            <input
                                type="hidden"
                                name="price"
                                id="selectedPrice"
                                value="<%= listing.halfPrice %>"
                            >


                            <button
                                type="submit"
                                class="add-btn"
                            >

                                <i class="fa-solid fa-bag-shopping"></i>

                                <span>
                                    Add to Bag
                                </span>

                            </button>

                        </form>


                        <!-- CANCEL -->

                        <a
                            href="/listings/<%= listing._id %>/cancle"
                            class="cancel-btn"
                        >

                            <i class="fa-solid fa-xmark"></i>

                            <span>
                                Cancel
                            </span>

                        </a>


                    </div>

                <% } %>


            </div>

        </section>



        <!-- =========================
             FEATURES
        ========================== -->

        <section class="food-features">

            <div class="feature-card">

                <div class="feature-icon">

                    <i class="fa-solid fa-bowl-food"></i>

                </div>

                <div>

                    <h4>Fresh Food</h4>

                    <p>Prepared with quality ingredients</p>

                </div>

            </div>


            <div class="feature-card">

                <div class="feature-icon">

                    <i class="fa-solid fa-clock"></i>

                </div>

                <div>

                    <h4>Quick Service</h4>

                    <p>Fast and reliable delivery</p>

                </div>

            </div>


            <div class="feature-card">

                <div class="feature-icon">

                    <i class="fa-solid fa-shield-heart"></i>

                </div>

                <div>

                    <h4>Quality Assured</h4>

                    <p>Fresh and hygienic preparation</p>

                </div>

            </div>

        </section>



        <!-- =========================
             REVIEW SECTION
        ========================== -->

        <section class="reviews-section">


            <div class="section-heading">

                <div>

                    <span class="section-tag">

                        CUSTOMER EXPERIENCE

                    </span>

                    <h2>

                        Customer Reviews

                    </h2>

                </div>


                <div class="review-summary">

                    <i class="fa-solid fa-star"></i>

                    <strong>4.5</strong>

                    <span>Rating</span>

                </div>

            </div>



            <!-- WRITE REVIEW -->

            <% if (currentUser) { %>

                <div class="write-review-card">

                    <h3>

                        Share your experience

                    </h3>


                    <form
                        action="/listings/<%= listing._id %>/reviews"
                        method="POST"
                    >


                        <!-- RATING -->

                        <div class="rating-group">

                            <p>
                                Rate this food
                            </p>


                            <div class="star-rating">


                                <input
                                    type="radio"
                                    id="star5"
                                    name="review[rating]"
                                    value="5"
                                    required
                                >

                                <label for="star5">
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star4"
                                    name="review[rating]"
                                    value="4"
                                >

                                <label for="star4">
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star3"
                                    name="review[rating]"
                                    value="3"
                                >

                                <label for="star3">
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star2"
                                    name="review[rating]"
                                    value="2"
                                >

                                <label for="star2">
                                    ★
                                </label>


                                <input
                                    type="radio"
                                    id="star1"
                                    name="review[rating]"
                                    value="1"
                                >

                                <label for="star1">
                                    ★
                                </label>

                            </div>

                        </div>


                        <!-- COMMENT -->

                        <div class="comment-group">

                            <label for="reviewComment">

                                Your Review

                            </label>


                            <textarea
                                id="reviewComment"
                                name="review[comment]"
                                placeholder="Tell us what you liked about this food..."
                                required
                            ></textarea>

                        </div>


                        <button
                            type="submit"
                            class="submit-review-btn"
                        >

                            <i class="fa-solid fa-paper-plane"></i>

                            Submit Review

                        </button>


                    </form>

                </div>


            <% } else { %>


                <div class="login-review-box">

                    <div class="login-review-icon">

                        <i class="fa-solid fa-lock"></i>

                    </div>


                    <div>

                        <h3>
                            Want to share your experience?
                        </h3>

                        <p>
                            Login to write a review.
                        </p>

                    </div>


                    <a href="/login">

                        Login

                    </a>

                </div>


            <% } %>



            <!-- ALL REVIEWS -->

            <div class="reviews-list">


                <% if (listing.reviews && listing.reviews.length > 0) { %>


                    <% listing.reviews.forEach(review => { %>

                        <article class="review-card">


                            <div class="review-top">

                                <div class="review-user">

                                    <div class="user-avatar">

                                        <i class="fa-solid fa-user"></i>

                                    </div>


                                    <div>

                                        <h4>
                                            Customer
                                        </h4>

                                        <span>
                                            Verified Review
                                        </span>

                                    </div>

                                </div>


                                <div class="review-stars">

                                    <% for (let i = 1; i <= 5; i++) { %>

                                        <% if (i <= review.rating) { %>

                                            <span class="filled">
                                                ★
                                            </span>

                                        <% } else { %>

                                            <span>
                                                ☆
                                            </span>

                                        <% } %>

                                    <% } %>

                                </div>

                            </div>


                            <p class="review-comment">

                                <%= review.comment %>

                            </p>


                        </article>

                    <% }) %>


                <% } else { %>


                    <div class="no-review">

                        <div class="no-review-icon">

                            <i class="fa-regular fa-star"></i>

                        </div>


                        <h3>
                            No reviews yet
                        </h3>

                        <p>
                            Be the first person to review this food!
                        </p>

                    </div>


                <% } %>


            </div>

        </section>



        <!-- =========================
             RELATED MENU
        ========================== -->

        <section class="related-section">


            <div class="section-heading related-heading">

                <div>

                    <span class="section-tag">

                        MORE DELICIOUS OPTIONS

                    </span>

                    <h2>

                        You may also like

                    </h2>

                </div>

            </div>


            <div class="related-container">


                <% if (relatedListings && relatedListings.length > 0) { %>


                    <% relatedListings.forEach(item => { %>


                        <a
                            href="/listings/<%= item._id %>"
                            class="related-card-link"
                        >

                            <article class="related-card">


                                <div class="related-image-box">

                                    <img
                                        src="<%= item.image.url %>"
                                        alt="<%= item.title %>"
                                        class="related-img"
                                    >

                                </div>


                                <div class="related-body">


                                    <h3>

                                        <%= item.title %>

                                    </h3>


                                    <p>

                                        <%= item.description %>

                                    </p>


                                    <div class="related-bottom">

                                        <span class="related-price">

                                            ₹<%= item.halfPrice ? item.halfPrice.toLocaleString("en-IN") : item.price.toLocaleString("en-IN") %>

                                        </span>


                                        <span class="view-food">

                                            View

                                            <i class="fa-solid fa-arrow-right"></i>

                                        </span>

                                    </div>


                                </div>


                            </article>

                        </a>


                    <% }) %>


                <% } else { %>

                    <p class="empty-related">

                        More delicious food coming soon!

                    </p>

                <% } %>


            </div>

        </section>


    </main>



    <!-- FOOTER -->

    <%- include("../partials/footer") %>



    <!-- =========================
         JAVASCRIPT
    ========================== -->

    <script>

        const halfBtn = document.getElementById("halfBtn");
        const fullBtn = document.getElementById("fullBtn");

        const foodPrice = document.getElementById("foodPrice");

        const variation = document.getElementById("variation");

        const selectedPrice =
            document.getElementById("selectedPrice");


        /* HALF */

        halfBtn.addEventListener("click", () => {

            foodPrice.innerHTML =
                "₹<%= listing.halfPrice.toLocaleString('en-IN') %>";

            variation.value = "Half";

            selectedPrice.value =
                "<%= listing.halfPrice %>";

            halfBtn.classList.add("active");

            fullBtn.classList.remove("active");

        });



        /* FULL */

        fullBtn.addEventListener("click", () => {

            foodPrice.innerHTML =
                "₹<%= listing.fullPrice.toLocaleString('en-IN') %>";

            variation.value = "Full";

            selectedPrice.value =
                "<%= listing.fullPrice %>";

            fullBtn.classList.add("active");

            halfBtn.classList.remove("active");

        });

    </script>


</body>

</html>