<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Profile</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

<link rel="stylesheet" href="/css/profile.css">
 <link rel="stylesheet" href="/css/nav.css">
  <link rel="icon" type="image/x-icon" href="/images/rest.png">  

</head>

<body>
     <%- include("../partials/nav") %>

<div class="profile-container">

<h2>My Profile</h2>

<!-- Profile Image -->

<div class="profile-image">

<img
id="profilePreview"
src="/css/images/user.png"
alt="upload image">

<label for="profileUpload" class="upload-btn">

<i class="fa-solid fa-camera"></i>

</label>

<input
type="file"
id="profileUpload"
accept="image/*"
hidden>

</div>

<!-- User Info -->

<div class="profile-card">

<div class="info">

<label>Username</label>

<p><%= currentUser.username %></p>

</div>



<div class="info">

<label>Saved Address</label>

<p>
<%= currentUser.address ? currentUser.address.addressLine : "No Address Saved" %>
</p>

</div>

</div>

<!-- Menu -->

<div class="menu">

<a href="/my-orders">

<i class="fa-solid fa-box"></i>

<span>My Orders</span>

<i class="fa-solid fa-angle-right"></i>

</a>
<a href="/chat">
    <i class="fa-solid fa-robot"></i>
    <span>Restaurant AI Assistant</span>
    <i class="fa-solid fa-angle-right"></i>
</a>



<a href="/term">

<i class="fa-solid fa-file-contract"></i>

<span>Terms & Conditions</span>

<i class="fa-solid fa-angle-right"></i>

</a>

<a href="/policy">

<i class="fa-solid fa-shield-halved"></i>

<span>Privacy Policy</span>

<i class="fa-solid fa-angle-right"></i>

</a>

<a href="/about">

<i class="fa-solid fa-circle-info"></i>

<span>About Us</span>

<i class="fa-solid fa-angle-right"></i>

</a>

</div>

<!-- Logout -->

<a href="/logout" class="logout-btn">

<i class="fa-solid fa-right-from-bracket"></i>

Logout

</a>

</div>

<script src="/js/profile.js"></script>

</body>
</html>