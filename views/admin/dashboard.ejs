<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Admin Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="/css/admin.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

</head>

<body>
    <div class="topbar">

    <h2>Dashboard</h2>

    <div class="admin-actions">

       <a href="/admin/order" class="notification">
    <i class="fas fa-bell"></i>

    <% if(unreadOrders > 0){ %>
        <span class="badge"><%= unreadOrders %></span>
    <% } %>
</a>

        <div class="admin-profile">
            <i class="fas fa-user-circle"></i>
            Admin
        </div>

    </div>

</div>

<div class="dashboard">

    <!-- Sidebar -->

    <div class="sidebar">

        <h2 class="logo">

            🍔 Admin

        </h2>

        <ul>

            <li class="active">

                <a href="/admin/dashboard">

                    <i class="fas fa-chart-line"></i>

                    Dashboard

                </a>

            </li>

          <li>

    <a href="/admin/user">

        <i class="fas fa-users"></i>

        Users

    </a>

</li>

           <li>

<a href="/admin/menu">

<i class="fas fa-utensils"></i>

Menu

</a>

</li>

          <li>

    <a href="/admin/order">

        <i class="fas fa-shopping-cart"></i>

        Orders

    </a>

</li>

          <li>

<a href="/admin/reviews">

<i class="fas fa-star"></i>

Reviews

</a>

</li>

           <li>

<a href="/admin/analytics">

<i class="fas fa-chart-bar"></i>

Analytics

</a>

</li>

            <li>

                <a href="/admin/logout">

                    <i class="fas fa-right-from-bracket"></i>

                    Logout

                </a>

            </li>

        </ul>

    </div>

    <!-- Main -->

    <div class="main-content">

        <div class="welcome">

            <h3>

                Welcome Back 👋

            </h3>

            <p>

                Manage your restaurant from one place.

            </p>

        </div>
        <div class="stats-container">

    <div class="card-box users">
        <div>
           <h3><%= totalUsers %></h3>
            <p>Total Users</p>
        </div>
        <i class="fas fa-users"></i>
    </div>

    <div class="card-box menu">
        <div>
           <h3><%= totalMenu %></h3>
            <p>Total Menu</p>
        </div>
        <i class="fas fa-utensils"></i>
    </div>

    <div class="card-box orders">
        <div>
           <h3><%= totalOrders %></h3>
            <p>Total Orders</p>
        </div>
        <i class="fas fa-shopping-bag"></i>
    </div>

    <div class="card-box reviews">
        <div>
           <h3><%= totalReviews %></h3>
            <p>Total Reviews</p>
        </div>
        <i class="fas fa-star"></i>
    </div>

</div>

<div class="table-section">

    <div class="table-header">

        <h3>Recent Orders</h3>

        <a href="#" class="view-all">

            View All

        </a>

    </div>

    <table>

        <thead>

            <tr>

                <th>Order ID</th>
                <th>Customer</th>
                <th>Food</th>
                <th>Amount</th>
                <th>Status</th>

            </tr>

        </thead>

       <tbody>

<% latestOrders.forEach(order => { %>

<tr>

<td><%= order._id.toString().slice(-6).toUpperCase() %></td>

<td><%= order.name %></td>

<td><%= order.items.map(item => item.foodName).join(", ") %></td>

<td>₹ <%= order.totalPrice %></td>

<td>

<span class="status delivered">

Paid

</span>

</td>

</tr>

<% }) %>

</tbody>

    </table>

</div>

    </div>

</div>

</body>

</html>