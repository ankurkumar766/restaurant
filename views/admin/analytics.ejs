<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<title>Analytics</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="/css/admin.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

</head>

<body>

<div class="dashboard">

<div class="sidebar">

<h2 class="logo">🍔 Admin</h2>

<ul>

<li>

<a href="/admin/dashboard">

<i class="fas fa-chart-line"></i>

Dashboard

</a>

</li>

<li>

<a href="/admin/users">

<i class="fas fa-users"></i>

Users

</a>

</li>

<li>

<a href="/admin/menu">

<i class="fas fa-utensils"></i>

Menu

</a>

</li>

<li>

<a href="/admin/orders">

<i class="fas fa-shopping-cart"></i>

Orders

</a>

</li>

<li>

<a href="/admin/reviews">

<i class="fas fa-star"></i>

Reviews

</a>

</li>

<li class="active">

<a href="/admin/analytics">

<i class="fas fa-chart-bar"></i>

Analytics

</a>

</li>

<li>

<a href="/admin/logout">

<i class="fas fa-right-from-bracket"></i>

Logout

</a>

</li>

</ul>

</div>

<div class="main-content">

<h2 class="mb-4">

Analytics

</h2>

<div class="stats-container">

<div class="card-box users">

<div>

<h3><%= totalUsers %></h3>

<p>Total Users</p>

</div>

<i class="fas fa-users"></i>

</div>

<div class="card-box menu">

<div>

<h3><%= totalMenu %></h3>

<p>Total Foods</p>

</div>

<i class="fas fa-utensils"></i>

</div>

<div class="card-box orders">

<div>

<h3><%= totalOrders %></h3>

<p>Total Orders</p>

</div>

<i class="fas fa-shopping-cart"></i>

</div>

<div class="card-box reviews">

<div>

<h3><%= totalReviews %></h3>

<p>Total Reviews</p>

</div>

<i class="fas fa-star"></i>

</div>

</div>

<br>

<div class="row">

<div class="col-md-6">

<div class="card p-4 shadow">

<h5>

Total Revenue

</h5>

<h2>

₹ <%= totalRevenue %>

</h2>

</div>

</div>

<div class="col-md-6">

<div class="card p-4 shadow">

<h5>

Today's Revenue

</h5>

<h2>

₹ <%= todayRevenue %>

</h2>

</div>

</div>

</div>

<br>

<div class="card shadow p-4">

<h4>

Today's Orders

</h4>

<h2>

<%= todayOrders %>

</h2>

</div>

</div>

</div>

</body>

</html>